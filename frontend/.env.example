# Vite Proxy Target: URL backend (dev: http://localhost:8000, docker: http://web:8000)
VITE_PROXY_TARGET=http://localhost:8000

# Stripe (modo test)
# Copia este archivo a .env y agrega tu key pública de Stripe test.
# Debe coincidir con STRIPE_PUBLISHABLE_KEY del .env en la raíz.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
